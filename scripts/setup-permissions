#!/usr/bin/python3
"""Install/remove the optional, narrowly scoped EasyTier polkit rule."""
import argparse
import datetime
import json
import os
from pathlib import Path
import pwd
import shutil
import sys
import tempfile

TARGET = Path("/etc/polkit-1/rules.d/50-omarchy-easytier.rules")
BACKUP = Path("/var/backups/omarchy-easytier")
MARKER = "// Generated by omarchy-easytier setup-permissions."
TEMPLATE = Path(__file__).resolve().parents[1] / "polkit/easytier.rules.in"


def render_rule(username):
    return TEMPLATE.read_text().replace("__USERNAME_JSON__", json.dumps(username, ensure_ascii=True))


def backup_existing():
    if not TARGET.exists():
        return
    BACKUP.mkdir(mode=0o700, parents=True, exist_ok=True)
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
    destination = BACKUP / (TARGET.name + "." + stamp)
    shutil.copy2(TARGET, destination)
    print(f"Previous rule backed up: {destination}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=["install", "remove"])
    parser.add_argument("--user", help="Desktop account allowed to start/stop/restart EasyTier")
    parser.add_argument("--dry-run", action="store_true", help="Preview without modifying the system")
    args = parser.parse_args()
    if args.action == "install":
        if not args.user:
            parser.error("install requires --user YOUR_DESKTOP_USER")
        try:
            account = pwd.getpwnam(args.user)
        except KeyError:
            parser.error("the specified local account does not exist")
        if account.pw_uid == 0:
            parser.error("choose your regular desktop account, not root")
        rule = render_rule(args.user)
        if args.dry_run:
            print(rule, end="")
            return 0
    elif args.dry_run:
        print(f"Would remove {TARGET}; EasyTier and its configuration are preserved.")
        return 0
    if os.geteuid() != 0:
        parser.error("run with sudo or pkexec to change polkit rules")
    if TARGET.is_symlink():
        parser.error("refusing to replace a symbolic link")
    if args.action == "remove":
        if not TARGET.exists():
            print("Permission rule is already absent.")
            return 0
        if not TARGET.read_text().startswith(MARKER):
            parser.error("refusing to remove a rule not generated by this installer")
        backup_existing()
        TARGET.unlink()
        print("Removed the plugin permission rule. EasyTier is unchanged.")
        return 0
    backup_existing()
    staged = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", dir=TARGET.parent, prefix=".omarchy-easytier-", delete=False) as stream:
            staged = Path(stream.name)
            stream.write(rule)
        os.chmod(staged, 0o644)
        os.chown(staged, 0, 0)
        os.replace(staged, TARGET)
    finally:
        if staged is not None and staged.exists():
            staged.unlink()
    print(f"Installed {TARGET} for {args.user}. Polkit reloads rules automatically.")
    print("Only start, stop and restart of easytier.service are authorized.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
